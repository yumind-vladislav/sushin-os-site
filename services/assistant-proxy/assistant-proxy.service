[Unit]
Description=Sushin OS Rover assistant proxy (OpenRouter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sushin-assistant
Group=sushin-assistant
WorkingDirectory=/opt/sushin-os-site/services/assistant-proxy
EnvironmentFile=/etc/sushin-assistant-proxy.conf
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
